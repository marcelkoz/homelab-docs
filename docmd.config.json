{
  "title": "Homelab Documentation",
  "url": "https://FIXME",
  "src": "docs",
  "out": "site",
  "engine": "js",
  "favicon": "assets/images/homelab_favicon.svg",
  "logo": {
    "light": "assets/images/homelab_logo.svg",
    "dark": "assets/images/homelab_logo.svg",
    "href": "/",
    "alt": "Documentation Logo"
  },
  "layout": {
    "spa": true,
    "header": {
      "enabled": true
    },
    "sidebar": {
      "collapsible": true,
      "defaultCollapsed": false
    },
    "optionsMenu": {
      "position": "sidebar-top",
      "components": {
        "search": true,
        "themeSwitch": true
      }
    },
    "footer": {
      "content": "{{ BUILD_YEAR }} Homelab. Built from git `{{ GIT_COMMIT }}`."
    }
  },
  "theme": {
    "name": "default",
    "appearance": "system",
    "codeHighlight": true
  },
  "minify": true,
  "autoTitleFromH1": true,
  "copyCode": true,
  "pageNavigation": true,
  "plugins": {
    "ai": {
      "assistant": false
    },
    "git": {},
    "llms": {},
    "okf": {},
    "seo": {},
    "sitemap": {}
  }
}
